---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog', ({ data }) => {
        return data.draft !== true;
    });
    return blogEntries.map(entry => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();

// Calculate reading time (average 200 words per minute)
const wordCount = entry.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Format date
const formattedDate = entry.data.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

// Calculate relative time for "Last Updated"
const now = new Date();
const postDate = entry.data.date;
const diffTime = Math.abs(now.getTime() - postDate.getTime());
const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

let relativeTime: string;
if (diffDays === 0) {
    relativeTime = 'Today';
} else if (diffDays === 1) {
    relativeTime = 'Yesterday';
} else if (diffDays < 7) {
    relativeTime = `${diffDays} days ago`;
} else if (diffDays < 30) {
    const weeks = Math.floor(diffDays / 7);
    relativeTime = weeks === 1 ? '1 week ago' : `${weeks} weeks ago`;
} else if (diffDays < 365) {
    const months = Math.floor(diffDays / 30);
    relativeTime = months === 1 ? '1 month ago' : `${months} months ago`;
} else {
    const years = Math.floor(diffDays / 365);
    relativeTime = years === 1 ? '1 year ago' : `${years} years ago`;
}

// Filter to only h2 for TOC (main sections only, no subheadings)
const tocHeadings = headings.filter(h => h.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
    <!-- Navigation Bar -->
    <nav>
        <div class="nav-content">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <a href="/" class="logo" style="text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 0.4em;">
                    <img src="/favicon.svg" alt="Logo" style="height: 1.7em; width: auto; vertical-align: middle; display: inline-block; margin-left: 0.1em;" />
                </a>
                <a href="/#blog" class="back-link">← Back to Blog</a>
            </div>
            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="nav-links" id="navLinks">
                <!-- TOC items for mobile hamburger -->
                <div class="mobile-toc-title">On This Page</div>
                {tocHeadings.map((heading) => (
                    <a href={`#${heading.slug}`} class="toc-nav-link">{heading.text}</a>
                ))}
                <div class="nav-divider"></div>
                <a href="/#blog">All Posts</a>
                <a href="/#projects">Projects</a>
                <a href="/#contact">Contact</a>
            </div>
        </div>
    </nav>

    <div class="blog-layout">
        <!-- Table of Contents Sidebar -->
        <aside class="toc-sidebar" id="tocSidebar">
            <div class="toc-container">
                <span class="toc-title">On This Page</span>
                <nav class="toc-nav">
                    <ul class="toc-list">
                        {tocHeadings.map((heading) => (
                            <li class={`toc-item toc-depth-${heading.depth}`}>
                                <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Article Content -->
        <article class="blog-post">
            <header class="blog-post-header">
                <h1>{entry.data.title}</h1>
                <div class="blog-post-meta">
                    <span class="meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
                    </span>
                    <span class="meta-item reading-time">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        {readingTime} min read
                    </span>
                    <span class="meta-item updated-badge" title={`Published: ${formattedDate}`}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 4v6h6"></path>
                            <path d="M23 20v-6h-6"></path>
                            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                        </svg>
                        Updated {relativeTime}
                    </span>
                    {entry.data.relatedProject && (
                        <a href={entry.data.relatedProject} class="related-project-link">
                            View Project →
                        </a>
                    )}
                </div>
                <div class="blog-post-tags">
                    {entry.data.tags.map((tag: string) => (
                        <span class="blog-tag">{tag}</span>
                    ))}
                </div>
            </header>
            
            <div class="blog-post-content" id="blogContent">
                <Content />
            </div>
            
            <footer class="blog-post-footer">
                <a href="/#blog" class="btn btn-secondary">← All Posts</a>
                {entry.data.relatedProject && (
                    <a href={entry.data.relatedProject} class="btn btn-tertiary">View Related Project →</a>
                )}
            </footer>
        </article>
    </div>

    <!-- Script Viewer Modal -->
    <div class="script-modal" id="scriptModal">
        <div class="script-modal-content">
            <div class="script-modal-header">
                <h3 id="scriptModalTitle">Script</h3>
                <div class="script-modal-actions">
                    <button class="script-btn" id="copyScriptBtn" title="Copy to clipboard">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        Copy
                    </button>
                    <button class="script-btn" id="downloadScriptBtn" title="Download file">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download
                    </button>
                    <button class="script-close-btn" id="closeScriptModal" title="Close">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="script-modal-body">
                <pre><code id="scriptModalCode"></code></pre>
            </div>
        </div>
    </div>

    <!-- Back to Top Button -->
    <button class="scroll-to-top" id="scrollToTopBlog" title="Back to top">
        <svg class="progress-ring" viewBox="0 0 56 56">
            <circle class="progress-ring-circle" cx="28" cy="28" r="26"></circle>
        </svg>
        <span class="arrow-icon">↑</span>
    </button>

    <script>
        // Back to top with progress
        (function() {
            const btn = document.getElementById('scrollToTopBlog');
            if (!btn) return;
            
            const progressCircle = btn.querySelector('.progress-ring-circle');
            const circumference = 2 * Math.PI * 26;
            
            if (progressCircle) {
                progressCircle.style.strokeDasharray = String(circumference);
                progressCircle.style.strokeDashoffset = String(circumference);
            }
            
            function updateProgress() {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0;
                
                if (scrollTop > 300) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
                
                if (progressCircle) {
                    const offset = circumference - (scrollPercent * circumference);
                    progressCircle.style.strokeDashoffset = String(offset);
                }
            }
            
            window.addEventListener('scroll', updateProgress, { passive: true });
            btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
            updateProgress();
        })();

        // Active TOC highlighting
        (function() {
            const tocLinks = document.querySelectorAll('.toc-link');
            const contentArea = document.getElementById('blogContent');
            if (!contentArea || tocLinks.length === 0) return;
            
            const headings = contentArea.querySelectorAll('h2');
            if (headings.length === 0) return;
            
            function updateActiveToc() {
                const scrollPos = window.scrollY + 150;
                let currentHeading = '';
                
                headings.forEach((heading) => {
                    const htmlHeading = heading as HTMLElement;
                    if (htmlHeading.offsetTop <= scrollPos) {
                        currentHeading = htmlHeading.id;
                    }
                });
                
                if (!currentHeading && headings.length > 0) {
                    currentHeading = (headings[0] as HTMLElement).id;
                }
                
                tocLinks.forEach(link => {
                    const href = link.getAttribute('href');
                    if (href === `#${currentHeading}`) {
                        link.classList.add('active');
                    } else {
                        link.classList.remove('active');
                    }
                });
            }
            
            window.addEventListener('scroll', updateActiveToc, { passive: true });
            setTimeout(updateActiveToc, 100);
            updateActiveToc();
        })();

        // Smooth scroll for TOC links
        document.querySelectorAll('.toc-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const href = link.getAttribute('href');
                if (!href) return;
                const targetId = href.slice(1);
                const target = document.getElementById(targetId);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    history.pushState(null, '', `#${targetId}`);
                }
            });
        });

        // Copy button for code blocks
        (function() {
            document.querySelectorAll('.blog-post-content pre').forEach((pre) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'code-block-wrapper';
                pre.parentNode?.insertBefore(wrapper, pre);
                wrapper.appendChild(pre);
                
                const copyBtn = document.createElement('button');
                copyBtn.className = 'code-copy-btn';
                copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;
                wrapper.appendChild(copyBtn);
                
                copyBtn.addEventListener('click', async () => {
                    const code = pre.querySelector('code')?.textContent || pre.textContent || '';
                    try {
                        await navigator.clipboard.writeText(code);
                        copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Copied!</span>`;
                        copyBtn.classList.add('copied');
                        setTimeout(() => {
                            copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;
                            copyBtn.classList.remove('copied');
                        }, 2000);
                    } catch (err) {
                        console.error('Failed to copy:', err);
                    }
                });
            });
        })();

        // Script viewer modal - using event delegation to catch clicks before navigation
        (function() {
            const modal = document.getElementById('scriptModal');
            const modalTitle = document.getElementById('scriptModalTitle');
            const modalCode = document.getElementById('scriptModalCode');
            const closeBtn = document.getElementById('closeScriptModal');
            const copyBtn = document.getElementById('copyScriptBtn');
            const downloadBtn = document.getElementById('downloadScriptBtn');
            const contentArea = document.getElementById('blogContent');
            
            if (!modal || !contentArea) return;
            
            let currentScript = { content: '', filename: '', url: '' };
            
            // Helper to check if a link is a script file
            function isScriptLink(href: string | null): boolean {
                if (!href) return false;
                return href.includes('/projects/') && 
                    (href.endsWith('.sh') || href.endsWith('.yml') || href.endsWith('.yaml'));
            }
            
            // Mark script links for styling
            contentArea.querySelectorAll('a').forEach(link => {
                if (isScriptLink(link.getAttribute('href'))) {
                    link.classList.add('script-link');
                }
            });
            
            // Use event delegation - capture phase to intercept before default behavior
            contentArea.addEventListener('click', async (e) => {
                const target = e.target as HTMLElement;
                const link = target.closest('a');
                
                if (!link) return;
                
                const href = link.getAttribute('href');
                if (!isScriptLink(href)) return;
                
                // Prevent navigation
                e.preventDefault();
                e.stopPropagation();
                
                const filename = href!.split('/').pop() || 'script';
                currentScript.filename = filename;
                currentScript.url = href!;
                
                if (modalTitle) modalTitle.textContent = filename;
                if (modalCode) modalCode.textContent = 'Loading...';
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
                
                try {
                    const response = await fetch(href!);
                    const content = await response.text();
                    currentScript.content = content;
                    if (modalCode) modalCode.textContent = content;
                } catch (err) {
                    if (modalCode) modalCode.textContent = 'Error loading script';
                    console.error('Failed to load script:', err);
                }
            }, true); // true = capture phase
            
            function closeModal() {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
            
            closeBtn?.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
            });
            
            copyBtn?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(currentScript.content);
                    const span = copyBtn.querySelector('span') || copyBtn;
                    const originalText = span.textContent;
                    span.textContent = 'Copied!';
                    setTimeout(() => { span.textContent = originalText; }, 2000);
                } catch (err) {
                    console.error('Failed to copy:', err);
                }
            });
            
            downloadBtn?.addEventListener('click', () => {
                const blob = new Blob([currentScript.content], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = currentScript.filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        })();

        // Hamburger menu functionality
        (function() {
            const hamburger = document.getElementById('hamburger');
            const navLinks = document.getElementById('navLinks');
            if (!hamburger || !navLinks) return;

            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navLinks.classList.toggle('active');
                document.body.classList.toggle('menu-open');
            });

            // Close menu when clicking a link
            navLinks.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                    document.body.classList.remove('menu-open');
                });
            });

            // Close menu on outside click
            document.addEventListener('click', (e) => {
                if (!hamburger.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                    document.body.classList.remove('menu-open');
                }
            });

            // Close menu on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                    document.body.classList.remove('menu-open');
                }
            });
        })();
    </script>

    <style>
        /* Back Link - matches project pages */
        .back-link {
            text-decoration: none;
            color: var(--accent-color, #00FF8C);
            font-size: 0.95rem;
            transition: opacity 0.3s;
        }
        .back-link:hover { 
            opacity: 0.7; 
        }

        /* Hide TOC items in nav on desktop - only show in hamburger on mobile */
        .mobile-toc-title,
        .toc-nav-link,
        .nav-divider {
            display: none;
        }

        /* Mobile Styles */
        @media (max-width: 900px) {
            .hamburger {
                display: flex;
            }

            .nav-links {
                position: fixed;
                top: 0;
                right: -100%;
                width: 80%;
                max-width: 300px;
                height: 100vh;
                background: rgba(10, 10, 20, 0.98);
                flex-direction: column;
                align-items: flex-start;
                padding: 80px 2rem 2rem;
                transition: right 0.3s ease;
                border-left: 1px solid rgba(0, 255, 140, 0.2);
                overflow-y: auto;
                gap: 0;
            }

            .nav-links.active {
                right: 0;
            }

            .nav-links a {
                padding: 0.8rem 0;
                width: 100%;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            /* Show mobile TOC items in hamburger */
            .mobile-toc-title {
                display: block;
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--accent-color, #00FF8C);
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 0.5rem;
                margin-top: 0.5rem;
            }

            .toc-nav-link {
                display: block;
                font-size: 0.85rem;
                color: var(--text-secondary, #8b949e) !important;
                padding: 0.5rem 0 0.5rem 1rem !important;
                border-left: 2px solid rgba(0, 255, 140, 0.2);
                border-bottom: none !important;
            }

            .toc-nav-link:hover {
                color: var(--accent-color, #00FF8C) !important;
                border-left-color: var(--accent-color, #00FF8C);
            }

            .nav-divider {
                display: block;
                width: 100%;
                height: 1px;
                background: rgba(0, 255, 140, 0.3);
                margin: 1rem 0;
            }

            .back-link {
                font-size: 0.8rem;
            }
        }

        @media (max-width: 768px) {
            .back-link {
                font-size: 0.8rem;
            }
        }

        @media (max-width: 480px) {
            .back-link {
                display: none;
            }
        }
    </style>
</BaseLayout>
