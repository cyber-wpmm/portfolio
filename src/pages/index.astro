        <script src="/src/scripts/main.js"></script>
        <script>
            // Typing animation for hero name (slower)
            const name = "WIN PHYO";
            const target = document.getElementById("typed-name");
            let i = 0;
            function type() {
                if (i < name.length) {
                    target.textContent += name.charAt(i);
                    i++;
                    setTimeout(type, 260);
                }
            }
            window.addEventListener('DOMContentLoaded', type);
        </script>
</BaseLayout>

