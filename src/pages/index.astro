    <script>
        // Certification PDF Modal Logic
        (function() {
            const certPdfs = [
                { url: '/Certificates/ccna-cyberops-certificate.pdf', title: 'CyberOps Associate' },
                { url: '/Certificates/ccna-network-security-certificate.pdf', title: 'Network Security' },
                { url: '/Certificates/ccna-enterprise-network-certificate.pdf', title: 'Enterprise Networking' },
                { url: '/Certificates/ccan-switching-certificate.pdf', title: 'Switching, Routing & Wireless' }
            ];
            
            let currentIndex = 0;
            const modal = document.getElementById('certPdfModal');
            const iframe = document.getElementById('certPdfIframe');
            const title = document.getElementById('certPdfTitle');
            const counter = document.getElementById('certPdfCounter');
            const closeBtn = document.getElementById('certPdfClose');
            const prevBtn = document.getElementById('certPdfPrev');
            const nextBtn = document.getElementById('certPdfNext');
            
            function showPdf(index) {
                currentIndex = ((index % certPdfs.length) + certPdfs.length) % certPdfs.length;
                iframe.src = certPdfs[currentIndex].url;
                title.textContent = certPdfs[currentIndex].title;
                counter.textContent = `${currentIndex + 1} / ${certPdfs.length}`;
            }
            
            function openModal(index) {
                showPdf(index);
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
            
            function closeModal() {
                modal.classList.remove('active');
                iframe.src = '';
                document.body.style.overflow = '';
            }
            
            // Attach click to all PDF buttons
            document.querySelectorAll('.cert-pdf-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const index = parseInt(btn.getAttribute('data-index'));
                    openModal(index);
                });
            });
            
            closeBtn.addEventListener('click', closeModal);
            prevBtn.addEventListener('click', () => showPdf(currentIndex - 1));
            nextBtn.addEventListener('click', () => showPdf(currentIndex + 1));
            
            // Close on backdrop click
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            
            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                if (!modal.classList.contains('active')) return;
                if (e.key === 'Escape') closeModal();
                if (e.key === 'ArrowLeft') showPdf(currentIndex - 1);
                if (e.key === 'ArrowRight') showPdf(currentIndex + 1);
            });
        })();
    </script>

