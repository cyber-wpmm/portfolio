        <!-- Education PDF Modal (Griffith Documents) -->
        <div class="pdf-modal" id="pdfModal">
            <div class="pdf-modal-content">
                <div class="pdf-modal-header">
                    <span class="pdf-modal-title" id="eduPdfTitle">Diploma Certificate</span>
                    <button class="close-pdf-btn-rect" id="eduPdfClose" title="Close PDF">✕ Close</button>
                </div>
                <div class="pdf-modal-viewer-row">
                    <button class="pdf-nav-btn" id="eduPdfPrev" title="Previous">‹</button>
                    <iframe id="pdfIframe" src="" allowfullscreen></iframe>
                    <button class="pdf-nav-btn" id="eduPdfNext" title="Next">›</button>
                </div>
                <div class="pdf-modal-counter" id="eduPdfCounter">1 / 4</div>
            </div>
        </div>

        <script>
            // Education PDF Modal Logic (Griffith Documents)
            (function() {
                const eduPdfs = [
                    { url: '/Certificates/griffith-diploma-certificate.pdf', title: 'Diploma Certificate' },
                    { url: '/Certificates/griffith-dux-award.pdf', title: 'Dux Award' },
                    { url: '/Certificates/griffith-academic-excellence.pdf', title: 'Academic Excellence Award' },
                    { url: '/Certificates/griffith-academic-transcript.pdf', title: 'Academic Transcript' }
                ];
                
                let currentEduIndex = 0;
                const modal = document.getElementById('pdfModal');
                const iframe = document.getElementById('pdfIframe');
                const title = document.getElementById('eduPdfTitle');
                const counter = document.getElementById('eduPdfCounter');
                const closeBtn = document.getElementById('eduPdfClose');
                const prevBtn = document.getElementById('eduPdfPrev');
                const nextBtn = document.getElementById('eduPdfNext');
                
                function showEduPdf(index) {
                    currentEduIndex = ((index % eduPdfs.length) + eduPdfs.length) % eduPdfs.length;
                    iframe.src = eduPdfs[currentEduIndex].url;
                    title.textContent = eduPdfs[currentEduIndex].title;
                    counter.textContent = `${currentEduIndex + 1} / ${eduPdfs.length}`;
                }
                
                window.openPDFModal = function(pdfUrl) {
                    // Find the index of the PDF, or default to 0
                    const index = eduPdfs.findIndex(p => p.url === pdfUrl);
                    showEduPdf(index >= 0 ? index : 0);
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                };
                
                window.closePDFModal = function() {
                    modal.style.display = 'none';
                    iframe.src = '';
                    document.body.style.overflow = '';
                };
                
                closeBtn?.addEventListener('click', closePDFModal);
                prevBtn?.addEventListener('click', () => showEduPdf(currentEduIndex - 1));
                nextBtn?.addEventListener('click', () => showEduPdf(currentEduIndex + 1));
                
                // Close on backdrop click
                modal?.addEventListener('click', (e) => {
                    if (e.target === modal) closePDFModal();
                });
                
                // Keyboard navigation
                document.addEventListener('keydown', (e) => {
                    if (modal?.style.display !== 'flex') return;
                    if (e.key === 'Escape') closePDFModal();
                    if (e.key === 'ArrowLeft') showEduPdf(currentEduIndex - 1);
                    if (e.key === 'ArrowRight') showEduPdf(currentEduIndex + 1);
                });
            })();
        </script>
    
    <!-- Scroll to Top Button with Progress Indicator -->
    <button class="scroll-to-top" id="scrollToTopHome" title="Back to top">
        <svg class="progress-ring" viewBox="0 0 56 56">
            <circle class="progress-ring-circle" cx="28" cy="28" r="26"></circle>
        </svg>
        <span class="arrow-icon">↑</span>
    </button>

    <script>
        // Enhanced Scroll-to-top with progress indicator
        (function() {
            const btn = document.getElementById('scrollToTopHome');
            if (!btn) return;
            
            const progressCircle = btn.querySelector('.progress-ring-circle');
            const circumference = 2 * Math.PI * 26; // radius = 26
            
            if (progressCircle) {
                progressCircle.style.strokeDasharray = circumference;
                progressCircle.style.strokeDashoffset = circumference;
            }
            
            function updateProgress() {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = scrollTop / docHeight;
                
                // Show/hide button
                if (scrollTop > 300) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
                
                // Update progress ring
                if (progressCircle) {
                    const offset = circumference - (scrollPercent * circumference);
                    progressCircle.style.strokeDashoffset = offset;
                }
            }
            
            window.addEventListener('scroll', updateProgress, { passive: true });
            btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        })();

        // Logo click - smooth scroll to top and clear URL hash
        const logoLink = document.getElementById('logoLink');
        if (logoLink) {
            logoLink.addEventListener('click', (e) => {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                history.pushState(null, '', window.location.pathname);
            });
        }

        // Theme Toggle Functionality
        const themeToggle = document.getElementById('themeToggle');
        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                const root = document.documentElement;
                root.classList.toggle('light-mode');
                
                // Save preference
                const isLight = root.classList.contains('light-mode');
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
            });
        }
    </script>
