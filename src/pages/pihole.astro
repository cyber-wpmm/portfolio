---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pi-hole Docker Deployment" description="Network-wide ad blocking using Docker containers on Raspberry Pi">
  <nav>
    <div class="nav-content">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <a href="/" class="logo" style="text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 0.4em;">
          <img src="/favicon.svg" alt="Logo" style="height: 1.7em; width: auto; vertical-align: middle; display: inline-block; margin-left: 0.1em;" />
        </a>
        <a href="/#projects" class="back-link">← Back to Projects</a>
      </div>
      <div class="nav-links" id="navLinks">
        <a href="#overview">Overview</a>
        <a href="#results">Results</a>
        <a href="#features">Features</a>
        <a href="#learnings">Learnings</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="project-hero">
    <div class="hero-container">
      <div class="hero-badge">Personal Project</div>
      <div class="hero-main">
        <div class="hero-text">
          <h1>Pi-hole <span class="gradient-text">Docker</span> Deployment</h1>
          <p class="hero-description">Network-wide ad blocking and DNS security solution deployed using Docker containers on a Raspberry Pi. Blocking ads, trackers, and malicious domains for all devices on my home network.</p>
          <div class="hero-buttons">
            <a href="/blog/pihole-docker" class="btn-primary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
              Read Setup Guide
            </a>
            <a href="https://github.com/cyber-wpmm/Pi-Hole" target="_blank" rel="noopener" class="btn-secondary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.012c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.529 2.341 1.088 2.91.833.091-.646.35-1.088.636-1.34-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.254-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.338 1.909-1.295 2.748-1.025 2.748-1.025.546 1.378.202 2.396.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.847-2.337 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.749 0 .268.18.579.688.481C19.138 20.175 22 16.427 22 12.012 22 6.484 17.523 2 12 2z"/></svg>
              View on GitHub
            </a>
          </div>
        </div>
        <div class="hero-logo">
          <img src="https://cdn.brandfetch.io/idu5KIKDYg/theme/dark/logo.svg?c=1bxid64Mup7aczewSAYMX&t=1763570042932" alt="Pi-hole Logo" />
        </div>
      </div>
    </div>
  </section>

  <div class="project-content">
    <!-- Dashboard Screenshot -->
    <section class="dashboard-section animate-on-scroll">
      <div class="dashboard-wrapper">
        <img src="https://raw.githubusercontent.com/cyber-wpmm/Pi-Hole/main/images/Dashboard.png" alt="Pi-hole Dashboard" class="dashboard-img" />
        <div class="dashboard-overlay">
          <span class="live-dot"></span>
          <span>Pi-hole Dashboard — Network-wide ad blocking in action</span>
        </div>
      </div>
    </section>

    <!-- Overview Section -->
    <section id="overview" class="section animate-on-scroll">
      <h2 class="section-title">Project Overview</h2>
      <div class="overview-cards">
        <div class="overview-card">
          <div class="card-icon">🎯</div>
          <h3>Objective</h3>
          <p>Deploy a network-wide DNS sinkhole to block advertisements, trackers, and malicious domains for all devices automatically.</p>
        </div>
        <div class="overview-card">
          <div class="card-icon">🔧</div>
          <h3>Approach</h3>
          <p>Containerized deployment using Docker on a Raspberry Pi, with custom blocklists and automated maintenance scripts.</p>
        </div>
        <div class="overview-card">
          <div class="card-icon">✅</div>
          <h3>Outcome</h3>
          <p>Successfully blocking ~30% of all DNS queries across the network, improving browsing speed and privacy.</p>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section id="results" class="section animate-on-scroll">
      <h2 class="section-title">Results & Impact</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">~30%</div>
          <div class="stat-label">Traffic Blocked</div>
          <p>Ads and trackers eliminated</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">1M+</div>
          <div class="stat-label">Blocked Domains</div>
          <p>Comprehensive blocklists</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Uptime</div>
          <p>Always-on protection</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">0</div>
          <div class="stat-label">Client Setup</div>
          <p>Network-wide, automatic</p>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="section animate-on-scroll">
      <h2 class="section-title">Key Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🛡️</span>
          <div>
            <h3>Network-Wide Blocking</h3>
            <p>All devices on the network automatically benefit without installing any software.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🐳</span>
          <div>
            <h3>Docker Containerized</h3>
            <p>Easy deployment, updates, and maintenance with isolated environment.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📊</span>
          <div>
            <h3>Real-time Dashboard</h3>
            <p>Monitor DNS queries, blocked requests, and statistics via web interface.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📝</span>
          <div>
            <h3>Custom Blocklists</h3>
            <p>Automated scripts to manage comprehensive blocklists from multiple sources.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">⚡</span>
          <div>
            <h3>Faster Browsing</h3>
            <p>Reduced page load times by blocking ads before they even load.</p>
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔒</span>
          <div>
            <h3>Enhanced Privacy</h3>
            <p>Block tracking domains and telemetry to protect all network users.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="section animate-on-scroll">
      <h2 class="section-title">Technology Stack</h2>
      <div class="tech-stack">
        <div class="tech-item">
          <img src="https://cdn.brandfetch.io/idu5KIKDYg/theme/dark/logo.svg" alt="Pi-hole" />
          <span>Pi-hole</span>
        </div>
        <div class="tech-item">
          <img src="https://cdn.brandfetch.io/id5_eOiB6T/theme/dark/logo.svg?c=1bxid64Mup7aczewSAYMX&t=1707508242946" alt="Docker" />
          <span>Docker</span>
        </div>
        <div class="tech-item">
          <img src="https://cdn.brandfetch.io/iddidqhhHC/w/400/h/400/theme/dark/icon.jpeg?c=1bxid64Mup7aczewSAYMX&t=1760505903692" alt="Raspberry Pi" />
          <span>Raspberry Pi</span>
        </div>
        <div class="tech-item">
          <img src="https://cdn.brandfetch.io/idQx9ZiJAu/theme/dark/symbol.svg?c=1bxid64Mup7aczewSAYMX&t=1668516066341" alt="Ubuntu Linux" />
          <span>Ubuntu</span>
        </div>
        <div class="tech-item">
          <img src="https://img.icons8.com/?size=100&id=9MJf0ngDwS8z&format=png&color=000000" alt="Bash" />
          <span>Bash</span>
        </div>
      </div>
    </section>

    <!-- Learnings Section -->
    <section id="learnings" class="section animate-on-scroll">
      <h2 class="section-title">What I Learned</h2>
      <div class="learnings-grid">
        <div class="learning-card">
          <h3>🌐 DNS & Networking</h3>
          <p>Deep understanding of how DNS resolution works, static IP configuration, and network traffic management.</p>
        </div>
        <div class="learning-card">
          <h3>🐳 Docker & Containers</h3>
          <p>Hands-on experience with containerization, Docker Compose, volume management, and container orchestration.</p>
        </div>
        <div class="learning-card">
          <h3>🔧 Linux Administration</h3>
          <p>Command line proficiency, service management, and troubleshooting on headless Linux systems.</p>
        </div>
        <div class="learning-card">
          <h3>📜 Bash Scripting</h3>
          <p>Writing automation scripts for blocklist management and system maintenance tasks.</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section animate-on-scroll">
      <div class="cta-content">
        <h2>Want to deploy your own Pi-hole?</h2>
        <p>I've documented the complete setup process including all configuration files, scripts, and troubleshooting tips.</p>
        <div class="cta-buttons">
          <a href="/blog/pihole-docker" class="btn-primary btn-large">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            Read the Full Setup Guide
          </a>
          <a href="/#projects" class="btn-tertiary">← Back to Projects</a>
        </div>
      </div>
    </section>

    <!-- Scroll to Top -->
    <button class="scroll-top" id="scrollTopBtn" title="Back to top">↑</button>
  </div>
</BaseLayout>

<style>
  .back-link {
    text-decoration: none;
    color: var(--accent-color, #00FF8C);
    font-size: 0.95rem;
    transition: opacity 0.3s;
  }
  .back-link:hover { opacity: 0.7; }

  /* Hero */
  .project-hero {
    padding: 7rem 2rem 3rem;
    background: linear-gradient(135deg, rgba(0, 255, 140, 0.05) 0%, transparent 60%);
  }
  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(0, 255, 140, 0.15);
    color: var(--accent-color, #00FF8C);
    padding: 0.5rem 1.2rem;
    border-radius: 25px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0, 255, 140, 0.3);
  }
  .hero-main {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-text h1 {
    font-size: 3.2rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--text-primary, #fff);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent-color, #00FF8C) 0%, #00d9ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary, #8b949e);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-logo {
    display: flex;
    justify-content: center;
  }
  .hero-logo img {
    width: 260px;
    height: 260px;
    background: #fff;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 25px 80px rgba(0, 255, 140, 0.2);
  }

  /* Buttons */
  .btn-primary, .btn-secondary, .btn-tertiary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.6rem;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
  }
  .btn-primary {
    background: var(--accent-color, #00FF8C);
    color: #000;
  }
  .btn-primary:hover {
    background: #00cc70;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 255, 140, 0.3);
  }
  .btn-secondary {
    background: transparent;
    color: var(--text-primary, #fff);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .btn-secondary:hover {
    border-color: var(--accent-color, #00FF8C);
    color: var(--accent-color, #00FF8C);
  }
  .btn-tertiary {
    background: transparent;
    color: var(--text-secondary, #8b949e);
  }
  .btn-tertiary:hover { color: var(--accent-color, #00FF8C); }
  .btn-large {
    padding: 1.1rem 2rem;
    font-size: 1.1rem;
  }

  /* Content */
  .project-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 5rem;
  }
  .section {
    margin-bottom: 5rem;
  }
  .section-title {
    font-size: 2rem;
    margin-bottom: 2.5rem;
    color: var(--text-primary, #fff);
    position: relative;
    display: inline-block;
  }
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--accent-color, #00FF8C);
    border-radius: 2px;
  }

  /* Dashboard */
  .dashboard-section { margin-bottom: 4rem; }
  .dashboard-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(0, 255, 140, 0.2);
  }
  .dashboard-img { width: 100%; display: block; }
  .dashboard-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.2rem 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.95));
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--text-secondary, #8b949e);
    font-size: 0.95rem;
  }
  .live-dot {
    width: 10px;
    height: 10px;
    background: var(--accent-color, #00FF8C);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 255, 140, 0.5); }
    50% { opacity: 0.7; box-shadow: 0 0 0 10px rgba(0, 255, 140, 0); }
  }

  /* Overview Cards */
  .overview-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .overview-card {
    background: rgba(13, 17, 23, 0.6);
    border: 1px solid rgba(0, 255, 140, 0.15);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }
  .overview-card:hover {
    border-color: var(--accent-color, #00FF8C);
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 255, 140, 0.1);
  }
  .card-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .overview-card h3 {
    color: var(--accent-color, #00FF8C);
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }
  .overview-card p {
    color: var(--text-secondary, #8b949e);
    line-height: 1.6;
    margin: 0;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .stat-card {
    background: rgba(0, 255, 140, 0.05);
    border: 1px solid rgba(0, 255, 140, 0.2);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }
  .stat-card:hover {
    border-color: var(--accent-color, #00FF8C);
    background: rgba(0, 255, 140, 0.1);
    transform: translateY(-3px);
  }
  .stat-number {
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--accent-color, #00FF8C);
    margin-bottom: 0.3rem;
  }
  .stat-label {
    font-size: 1rem;
    color: var(--text-primary, #fff);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .stat-card p {
    font-size: 0.85rem;
    color: var(--text-secondary, #8b949e);
    margin: 0;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .feature-card {
    display: flex;
    gap: 1.2rem;
    padding: 1.5rem;
    background: rgba(13, 17, 23, 0.5);
    border: 1px solid rgba(0, 255, 140, 0.1);
    border-radius: 12px;
    transition: all 0.3s ease;
  }
  .feature-card:hover {
    border-color: rgba(0, 255, 140, 0.3);
    background: rgba(13, 17, 23, 0.7);
  }
  .feature-icon { font-size: 2rem; }
  .feature-card h3 {
    color: var(--text-primary, #fff);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }
  .feature-card p {
    color: var(--text-secondary, #8b949e);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Tech Stack */
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2.5rem;
    background: rgba(13, 17, 23, 0.6);
    border: 1px solid rgba(0, 255, 140, 0.15);
    border-radius: 16px;
    transition: all 0.3s ease;
    min-width: 140px;
  }
  .tech-item:hover {
    border-color: var(--accent-color, #00FF8C);
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 255, 140, 0.15);
  }
  .tech-item img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .tech-item span {
    color: var(--text-secondary, #8b949e);
    font-size: 1rem;
    font-weight: 500;
  }

  /* Learnings */
  .learnings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .learning-card {
    background: rgba(13, 17, 23, 0.5);
    border: 1px solid rgba(0, 255, 140, 0.1);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }
  .learning-card:hover {
    border-color: rgba(0, 255, 140, 0.3);
  }
  .learning-card h3 {
    color: var(--text-primary, #fff);
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
  }
  .learning-card p {
    color: var(--text-secondary, #8b949e);
    line-height: 1.6;
    margin: 0;
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, rgba(0, 255, 140, 0.1) 0%, rgba(0, 217, 255, 0.05) 100%);
    border: 1px solid rgba(0, 255, 140, 0.2);
    border-radius: 20px;
    padding: 4rem;
    text-align: center;
    margin-top: 3rem;
  }
  .cta-content h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary, #fff);
  }
  .cta-content p {
    color: var(--text-secondary, #8b949e);
    font-size: 1.1rem;
    max-width: 550px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Scroll Top */
  .scroll-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    border: none;
    background: rgba(13, 17, 23, 0.9);
    color: var(--accent-color, #00FF8C);
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1000;
    border: 1px solid rgba(0, 255, 140, 0.3);
  }
  .scroll-top.show {
    opacity: 1;
    visibility: visible;
  }
  .scroll-top:hover {
    transform: translateY(-3px);
    border-color: var(--accent-color, #00FF8C);
    box-shadow: 0 5px 20px rgba(0, 255, 140, 0.3);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-main {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-buttons { justify-content: center; }
    .hero-logo { order: -1; }
    .hero-logo img { width: 200px; height: 200px; }
    .overview-cards { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .features-grid { grid-template-columns: 1fr; }
    .learnings-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .hero-text h1 { font-size: 2.2rem; }
    .stats-grid { grid-template-columns: 1fr; }
    .cta-section { padding: 2.5rem 1.5rem; }
    .cta-content h2 { font-size: 1.5rem; }
    .tech-item img { width: 56px; height: 56px; }
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .animate-on-scroll.visible {
